+			if
+			(	(3*ArrayNum<2*ArrayMax || (ArrayMax-ArrayNum)*ElementSize>=16384)
+			&&	(ArrayMax-ArrayNum>64 || ArrayNum==0) )
+			{
+				ArrayMax = ArrayNum;
+				Realloc( ElementSize );
+			}
+		}
+		checkSlow(ArrayNum>=0);
+		checkSlow(ArrayMax>=ArrayNum);
+		unguardSlow;
+	}
