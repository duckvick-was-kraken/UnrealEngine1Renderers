+	void Remove( INT Index, INT Count, INT ElementSize )
+	{
+		guardSlow(FArray::Remove);
+		if( Count>0 )
+		{
+			appMemmove
+			(
+				(BYTE*)Data + (Index      ) * ElementSize,
+				(BYTE*)Data + (Index+Count) * ElementSize,
+				(ArrayNum - Index - Count ) * ElementSize
+			);
